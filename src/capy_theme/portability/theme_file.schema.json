{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "capy-theme export (theme.json)",
  "description": "What a theme export zip says about the theme. Fonts and images are referred to by key; their files are in the zip under fonts/ and images/.",
  "type": "object",
  "required": ["format", "theme", "fonts", "images"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "capy-theme-export/1"},
    "exported_by": {"type": "string", "maxLength": 100},
    "theme": {
      "type": "object",
      "required": ["name", "slug", "light_base", "dark_base", "settings"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "slug": {"type": "string", "pattern": "^[-a-zA-Z0-9_]{1,100}$"},
        "light_base": {"type": "string", "maxLength": 50},
        "dark_base": {"type": "string", "maxLength": 50},
        "settings": {"type": "object"},
        "font_roles": {"type": "object", "additionalProperties": {"type": "string"}},
        "image_slots": {
          "type": "object",
          "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    },
    "fonts": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": {
        "type": "object",
        "required": ["family", "source", "files"],
        "additionalProperties": false,
        "properties": {
          "family": {"type": "string", "minLength": 1, "maxLength": 100},
          "source": {"enum": ["system", "bundled", "upload", "google", "external"]},
          "fallback_stack": {"type": "string", "maxLength": 300},
          "licence": {"type": "string", "maxLength": 2000},
          "stylesheet_url": {"type": "string", "maxLength": 500},
          "files": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "required": ["path", "weight", "style"],
              "additionalProperties": false,
              "properties": {
                "path": {"type": "string", "pattern": "^fonts/[-a-zA-Z0-9_.]{1,150}\\.woff2$"},
                "weight": {"type": "integer", "minimum": 1, "maximum": 1000},
                "style": {"enum": ["normal", "italic"]},
                "subset": {"type": "string", "maxLength": 20},
                "unicode_range": {"type": "string", "maxLength": 2000}
              }
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "object",
        "required": ["slot", "mode", "path"],
        "additionalProperties": false,
        "properties": {
          "slot": {"type": "string", "maxLength": 40},
          "mode": {"enum": ["light", "dark"]},
          "alt_text": {"type": "string", "maxLength": 200},
          "path": {"type": "string", "pattern": "^images/[-a-zA-Z0-9_.]{1,150}$"}
        }
      }
    }
  }
}
