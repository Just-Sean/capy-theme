{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Just-Sean/capy-theme/settings.schema.json",
  "title": "capy-theme Theme.settings",
  "description": "Every override a theme makes on top of its light and dark base themes. Each phase adds its own keys here (colours, fonts, shape and so on). Keys not listed are rejected.",
  "type": "object",
  "properties": {
    "site_name": {
      "description": "The site's name, shown in headers and used as the logo's fallback.",
      "type": "string",
      "maxLength": 100
    },
    "tagline": {
      "description": "A short line describing the site.",
      "type": "string",
      "maxLength": 200
    },
    "logo_alt": {
      "description": "Alt text for the main logo. Falls back to the site name.",
      "type": "string",
      "maxLength": 200
    },
    "default_mode": {
      "description": "The colour mode pages use: \"auto\" follows the visitor's device, \"light\" or \"dark\" forces one. Default \"auto\".",
      "type": "string",
      "enum": [
        "auto",
        "light",
        "dark"
      ]
    },
    "visitors_can_switch": {
      "description": "Whether visitors can choose light, dark or auto with {% theme_mode_toggle %}. Default true.",
      "type": "boolean"
    },
    "colors": {
      "description": "Colour overrides, separately for light and dark. Anything not set comes from the base theme.",
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "primary": {
              "$ref": "#/$defs/color"
            },
            "secondary": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "neutral": {
              "$ref": "#/$defs/color"
            },
            "base-100": {
              "$ref": "#/$defs/color"
            },
            "base-content": {
              "$ref": "#/$defs/color"
            },
            "info": {
              "$ref": "#/$defs/color"
            },
            "success": {
              "$ref": "#/$defs/color"
            },
            "warning": {
              "$ref": "#/$defs/color"
            },
            "error": {
              "$ref": "#/$defs/color"
            },
            "base-200": {
              "$ref": "#/$defs/color"
            },
            "base-300": {
              "$ref": "#/$defs/color"
            },
            "primary-content": {
              "$ref": "#/$defs/color"
            },
            "secondary-content": {
              "$ref": "#/$defs/color"
            },
            "accent-content": {
              "$ref": "#/$defs/color"
            },
            "neutral-content": {
              "$ref": "#/$defs/color"
            },
            "info-content": {
              "$ref": "#/$defs/color"
            },
            "success-content": {
              "$ref": "#/$defs/color"
            },
            "warning-content": {
              "$ref": "#/$defs/color"
            },
            "error-content": {
              "$ref": "#/$defs/color"
            }
          },
          "additionalProperties": false
        },
        "dark": {
          "type": "object",
          "properties": {
            "primary": {
              "$ref": "#/$defs/color"
            },
            "secondary": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "neutral": {
              "$ref": "#/$defs/color"
            },
            "base-100": {
              "$ref": "#/$defs/color"
            },
            "base-content": {
              "$ref": "#/$defs/color"
            },
            "info": {
              "$ref": "#/$defs/color"
            },
            "success": {
              "$ref": "#/$defs/color"
            },
            "warning": {
              "$ref": "#/$defs/color"
            },
            "error": {
              "$ref": "#/$defs/color"
            },
            "base-200": {
              "$ref": "#/$defs/color"
            },
            "base-300": {
              "$ref": "#/$defs/color"
            },
            "primary-content": {
              "$ref": "#/$defs/color"
            },
            "secondary-content": {
              "$ref": "#/$defs/color"
            },
            "accent-content": {
              "$ref": "#/$defs/color"
            },
            "neutral-content": {
              "$ref": "#/$defs/color"
            },
            "info-content": {
              "$ref": "#/$defs/color"
            },
            "success-content": {
              "$ref": "#/$defs/color"
            },
            "warning-content": {
              "$ref": "#/$defs/color"
            },
            "error-content": {
              "$ref": "#/$defs/color"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shape": {
      "description": "Shape and effect overrides, for both light and dark. Anything not set comes from the base theme.",
      "type": "object",
      "properties": {
        "radius_selector": {
          "description": "Small corner radius (--radius-selector), in rem. Checkboxes, toggles and badges. 0 is square.",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "radius_field": {
          "description": "Field corner radius (--radius-field), in rem. Buttons, inputs, selects and tabs. 0 is square.",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "radius_box": {
          "description": "Box corner radius (--radius-box), in rem. Cards, alerts, modals and other boxes. 0 is square.",
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "size_selector": {
          "description": "Small control size (--size-selector), in rem. Base size of checkboxes, toggles and badges (daisyUI uses 0.1875\u20130.3125).",
          "type": "number",
          "minimum": 0.125,
          "maximum": 0.5
        },
        "size_field": {
          "description": "Field size (--size-field), in rem. Base size of buttons and inputs (daisyUI uses 0.1875\u20130.3125).",
          "type": "number",
          "minimum": 0.125,
          "maximum": 0.5
        },
        "border": {
          "description": "Border width (--border), in px. Width of borders, in pixels.",
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "depth": {
          "description": "Depth (--depth): on or off. A subtle 3D shadow on buttons and other controls.",
          "type": "boolean"
        },
        "noise": {
          "description": "Noise (--noise): on or off. A subtle grain texture on controls.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fonts": {
      "description": "Fonts from the library (by id) for each role. Roles not set use the project's defaults.",
      "type": "object",
      "properties": {
        "body": {
          "type": "integer",
          "minimum": 1
        },
        "heading": {
          "type": "integer",
          "minimum": 1
        },
        "mono": {
          "type": "integer",
          "minimum": 1
        },
        "display": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "color": {
      "description": "A colour in OKLCH, as daisyUI writes them, e.g. oklch(62% 0.19 260).",
      "type": "string",
      "pattern": "^oklch\\(\\s*[0-9.]+%?\\s+[0-9.]+\\s+[0-9.]+(\\s*/\\s*[0-9.]+%?)?\\s*\\)$"
    }
  }
}
