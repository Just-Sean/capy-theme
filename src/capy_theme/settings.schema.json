{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Just-Sean/capy-theme/settings.schema.json",
  "title": "capy-theme Theme.settings",
  "description": "Every override a theme makes on top of its light and dark base themes. Each phase adds its own keys here (colours, fonts, shape and so on). Keys not listed are rejected.",
  "type": "object",
  "properties": {
    "site_name": {
      "description": "The site's name, shown in headers and used as the logo's fallback.",
      "type": "string",
      "maxLength": 100
    },
    "tagline": {
      "description": "A short line describing the site.",
      "type": "string",
      "maxLength": 200
    },
    "logo_alt": {
      "description": "Alt text for the main logo. Falls back to the site name.",
      "type": "string",
      "maxLength": 200
    },
    "default_mode": {
      "description": "The colour mode pages use: \"auto\" follows the visitor's device, \"light\" or \"dark\" forces one. Default \"auto\".",
      "type": "string",
      "enum": [
        "auto",
        "light",
        "dark"
      ]
    },
    "visitors_can_switch": {
      "description": "Whether visitors can choose light, dark or auto with {% theme_mode_toggle %}. Default true.",
      "type": "boolean"
    },
    "colors": {
      "description": "Colour overrides, separately for light and dark. Anything not set comes from the base theme.",
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "primary": {
              "$ref": "#/$defs/color"
            },
            "secondary": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "neutral": {
              "$ref": "#/$defs/color"
            },
            "base-100": {
              "$ref": "#/$defs/color"
            },
            "base-content": {
              "$ref": "#/$defs/color"
            },
            "info": {
              "$ref": "#/$defs/color"
            },
            "success": {
              "$ref": "#/$defs/color"
            },
            "warning": {
              "$ref": "#/$defs/color"
            },
            "error": {
              "$ref": "#/$defs/color"
            },
            "base-200": {
              "$ref": "#/$defs/color"
            },
            "base-300": {
              "$ref": "#/$defs/color"
            },
            "primary-content": {
              "$ref": "#/$defs/color"
            },
            "secondary-content": {
              "$ref": "#/$defs/color"
            },
            "accent-content": {
              "$ref": "#/$defs/color"
            },
            "neutral-content": {
              "$ref": "#/$defs/color"
            },
            "info-content": {
              "$ref": "#/$defs/color"
            },
            "success-content": {
              "$ref": "#/$defs/color"
            },
            "warning-content": {
              "$ref": "#/$defs/color"
            },
            "error-content": {
              "$ref": "#/$defs/color"
            }
          },
          "additionalProperties": false
        },
        "dark": {
          "type": "object",
          "properties": {
            "primary": {
              "$ref": "#/$defs/color"
            },
            "secondary": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "neutral": {
              "$ref": "#/$defs/color"
            },
            "base-100": {
              "$ref": "#/$defs/color"
            },
            "base-content": {
              "$ref": "#/$defs/color"
            },
            "info": {
              "$ref": "#/$defs/color"
            },
            "success": {
              "$ref": "#/$defs/color"
            },
            "warning": {
              "$ref": "#/$defs/color"
            },
            "error": {
              "$ref": "#/$defs/color"
            },
            "base-200": {
              "$ref": "#/$defs/color"
            },
            "base-300": {
              "$ref": "#/$defs/color"
            },
            "primary-content": {
              "$ref": "#/$defs/color"
            },
            "secondary-content": {
              "$ref": "#/$defs/color"
            },
            "accent-content": {
              "$ref": "#/$defs/color"
            },
            "neutral-content": {
              "$ref": "#/$defs/color"
            },
            "info-content": {
              "$ref": "#/$defs/color"
            },
            "success-content": {
              "$ref": "#/$defs/color"
            },
            "warning-content": {
              "$ref": "#/$defs/color"
            },
            "error-content": {
              "$ref": "#/$defs/color"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shape": {
      "description": "Shape and effect overrides, for both light and dark. Anything not set comes from the base theme.",
      "type": "object",
      "properties": {
        "radius_selector": {
          "description": "Small corner radius (--radius-selector), in rem. Checkboxes, toggles and badges. 0 is square.",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "radius_field": {
          "description": "Field corner radius (--radius-field), in rem. Buttons, inputs, selects and tabs. 0 is square.",
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "radius_box": {
          "description": "Box corner radius (--radius-box), in rem. Cards, alerts, modals and other boxes. 0 is square.",
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "size_selector": {
          "description": "Small control size (--size-selector), in rem. Base size of checkboxes, toggles and badges (daisyUI uses 0.1875\u20130.3125).",
          "type": "number",
          "minimum": 0.125,
          "maximum": 0.5
        },
        "size_field": {
          "description": "Field size (--size-field), in rem. Base size of buttons and inputs (daisyUI uses 0.1875\u20130.3125).",
          "type": "number",
          "minimum": 0.125,
          "maximum": 0.5
        },
        "border": {
          "description": "Border width (--border), in px. Width of borders, in pixels.",
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "depth": {
          "description": "Depth (--depth): on or off. A subtle 3D shadow on buttons and other controls.",
          "type": "boolean"
        },
        "noise": {
          "description": "Noise (--noise): on or off. A subtle grain texture on controls.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fonts": {
      "description": "Fonts from the library (by id) for each role. Roles not set use the project's defaults.",
      "type": "object",
      "properties": {
        "body": {
          "type": "integer",
          "minimum": 1
        },
        "heading": {
          "type": "integer",
          "minimum": 1
        },
        "mono": {
          "type": "integer",
          "minimum": 1
        },
        "display": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "type": {
      "description": "The type scale. Unset values leave the project's styles alone.",
      "type": "object",
      "properties": {
        "base_size": {
          "description": "Base text size (px). The size of body text. Everything sized in rem scales with it. At least 14px, so text stays readable.",
          "type": "number",
          "minimum": 14,
          "maximum": 24
        },
        "scale": {
          "description": "Heading scale (\u00d7). How much bigger each heading level is than the next (h6 is the base size). 1.25 is a common choice.",
          "type": "number",
          "minimum": 1.05,
          "maximum": 1.6
        },
        "line_height": {
          "description": "Line height (\u00d7). Space between lines of body text, e.g. 1.5.",
          "type": "number",
          "minimum": 1.1,
          "maximum": 2.2
        },
        "heading_weight": {
          "description": "Heading weight. 400 is regular, 700 bold.",
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        }
      },
      "additionalProperties": false
    },
    "images": {
      "description": "The uploaded image (ThemeAsset id) used in each slot, for light and dark mode. Dark falls back to light; most logo slots fall back to the main logo.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "logo_main",
          "logo_stacked",
          "logo_mark",
          "logo_wordmark",
          "logo_email",
          "logo_print",
          "icon",
          "social",
          "background_login",
          "background_pattern"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "light": {
            "type": "integer",
            "minimum": 1
          },
          "dark": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "logo": {
      "description": "Header logo heights in pixels.",
      "type": "object",
      "properties": {
        "header_height": {
          "description": "Header logo height (px).",
          "type": "integer",
          "minimum": 16,
          "maximum": 200
        },
        "header_height_mobile": {
          "description": "Header logo height on phones (px).",
          "type": "integer",
          "minimum": 16,
          "maximum": 200
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "color": {
      "description": "A colour in OKLCH, as daisyUI writes them, e.g. oklch(62% 0.19 260).",
      "type": "string",
      "pattern": "^oklch\\(\\s*[0-9.]+%?\\s+[0-9.]+\\s+[0-9.]+(\\s*/\\s*[0-9.]+%?)?\\s*\\)$"
    }
  }
}
